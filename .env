# n8n AI Assistant - PUBLIC TEMPLATE ONLY
# Replace every CHANGE_ME value before deployment.
# Never commit real passwords, tokens or API keys to this public repository.

N8N_VERSION=2.36.9

# Domains
N8N_HOST=n8n.example.com
SEARXNG_HOST=search.example.com

# Existing Traefik installation
TRAEFIK_NETWORK=traefik_proxy
TRAEFIK_HTTPS_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# Locale
GENERIC_TIMEZONE=Europe/London

# PostgreSQL
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD

# n8n security / external Task Runners
N8N_ENCRYPTION_KEY=CHANGE_ME_RANDOM_64_CHAR_ENCRYPTION_KEY
N8N_RUNNERS_AUTH_TOKEN=CHANGE_ME_RANDOM_TASK_RUNNER_TOKEN

# SearXNG / Instance AI search
SEARXNG_SECRET=CHANGE_ME_RANDOM_SEARXNG_SECRET
INSTANCE_AI_BRAVE_SEARCH_API_KEY=

# n8n Sandbox Service
# SANDBOX_API_KEYS and N8N_SANDBOX_SERVICE_API_KEY MUST be identical.
SANDBOX_API_KEYS=CHANGE_ME_RANDOM_SANDBOX_API_KEY
N8N_SANDBOX_SERVICE_API_KEY=CHANGE_ME_RANDOM_SANDBOX_API_KEY

# These two registration-token values MUST be identical.
SANDBOX_API_RUNNER_REGISTRATION_TOKEN=CHANGE_ME_RANDOM_SANDBOX_REGISTRATION_TOKEN
SANDBOX_RUNNER_REGISTRATION_TOKEN=CHANGE_ME_RANDOM_SANDBOX_REGISTRATION_TOKEN

# These two runner API-key values MUST be identical.
SANDBOX_API_RUNNER_API_KEY=CHANGE_ME_RANDOM_SANDBOX_RUNNER_API_KEY
SANDBOX_RUNNER_API_KEYS=CHANGE_ME_RANDOM_SANDBOX_RUNNER_API_KEY

# AI provider - add when ready
OPENAI_API_KEY=CHANGE_ME_LATER
